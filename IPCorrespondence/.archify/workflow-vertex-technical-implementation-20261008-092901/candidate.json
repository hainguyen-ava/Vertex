  "cards": [
    { "dot": "cyan", "title": "Trigger & ingestion", "items": ["Outlook \"When a new email arrives (V3)\" trigger scoped to the shared mailbox", "Includes new messages, replies, and acknowledgements"] },
    { "dot": "violet", "title": "Agent: instructions + skill (Azure OpenAI via Foundry)", "items": ["Instructions: system prompt encodes Ref # lead-in phrases (\"Client Reference:\", \"Your Ref\", etc.) and known matter prefixes", "Skill: identifies the Ref # in the title/body and maps known prefixes/aliases to the right matter — a trainable component business can extend with new mapping rules, without rewriting the core instructions", "Output only: the agent call always returns a structured JSON result string — reference, is_vertex, segments, normalized_value, confidence. The agent never branches or decides."] },
    { "dot": "amber", "title": "Parse JSON + Decide (deterministic, in Power Automate)", "items": ["Power Automate's Parse JSON action reads the result string returned to the Power App/flow", "A Condition action then makes the ref-found vs. ref-not-found decision — this logic lives entirely in the flow, not in the Azure OpenAI call", "Found → continues to the Folder Rule Validator; not found → routes straight to Log Exception"] },
    { "dot": "amber", "title": "Folder Rule Validator (deterministic, in Power Automate)", "items": ["Implemented as a Condition/Switch action in the flow, not a model call", "Vertex reference: exactly 2 segments (e.g. 00-113)", "Non-Vertex reference: prefix + 2 segments (e.g. SEM-24-783)", "Country-code suffixes stripped before validation"] },
    { "dot": "emerald", "title": "Dataverse schema", "items": ["One table: Message ID, Sender, Subject, Reference, Folder, Result, Timestamp (UTC), Exception Type", "Result = Filed / Created Folder and Filed / Exception", "Index on Timestamp + Result for fast daily queries"] },
    { "dot": "rose", "title": "Implementation recommendations", "items": ["Check Dataverse for an existing Message ID before filing, to make retries idempotent", "Wrap Outlook actions in a Scope with \"configure run after\" to catch failures as exceptions", "Keep the two flows independent: real-time filing never waits on the daily report"] }
  ]
